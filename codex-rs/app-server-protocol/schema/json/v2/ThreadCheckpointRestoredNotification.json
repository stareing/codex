{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadCheckpointChange": {
      "oneOf": [
        {
          "description": "The file gets its earlier content back.",
          "enum": [
            "restore"
          ],
          "type": "string"
        },
        {
          "description": "The file did not exist then and is deleted.",
          "enum": [
            "delete"
          ],
          "type": "string"
        },
        {
          "description": "The file is gone now and is written again.",
          "enum": [
            "recreate"
          ],
          "type": "string"
        }
      ]
    },
    "ThreadCheckpointFileChange": {
      "properties": {
        "change": {
          "$ref": "#/definitions/ThreadCheckpointChange"
        },
        "deletions": {
          "description": "Lines removed by the rewind.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "insertions": {
          "description": "Lines added by the rewind.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "change",
        "deletions",
        "insertions",
        "path"
      ],
      "type": "object"
    }
  },
  "description": "Files of a thread were rewound (or a rewind was undone, `turnId` absent).",
  "properties": {
    "filesChanged": {
      "items": {
        "$ref": "#/definitions/ThreadCheckpointFileChange"
      },
      "type": "array"
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "filesChanged",
    "threadId"
  ],
  "title": "ThreadCheckpointRestoredNotification",
  "type": "object"
}